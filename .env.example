# ============ 飞书自建应用 ============
# 开放平台后台 -> 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 事件回调加解密密钥（开放平台 -> 事件订阅 -> Encrypt Key），留空表示不校验/不解密
FEISHU_ENCRYPT_KEY=
# 事件回调校验 token（Verification Token），留空表示不校验
FEISHU_VERIFICATION_TOKEN=

# 需要同步的群 chat_id，多个用英文逗号分隔（oc_ 开头）
FEISHU_CHAT_IDS=oc_xxxxxxxxxxxxxxxx

# 没有公网回调地址时的兜底方案：轮询拉取群消息
# 1 开启，0 关闭；开启后每 SYNC_INTERVAL_SECONDS 秒回溯 SYNC_LOOKBACK_MINUTES 分钟的消息
FEISHU_AUTO_SYNC=0
SYNC_INTERVAL_SECONDS=300
SYNC_LOOKBACK_MINUTES=15
# 新加入的群首次同步自动回补多少天（只回看 15 分钟的话，加群前的历史消息永远进不来）
SYNC_BACKFILL_DAYS=7

# ============ 运行配置 ============
# 数据库地址，默认 sqlite 文件
DATABASE_URL=sqlite:///data/app.db
# 附件（订单截图）保存目录
MEDIA_DIR=data/media
# 解析规则文件
RULES_FILE=config/parse_rules.yaml
# 对外访问地址（用于生成图片外链）
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ============ OCR ============
# none | tesseract | http
OCR_PROVIDER=none
OCR_HTTP_URL=
OCR_HTTP_FIELD=image
OCR_HTTP_TEXT_KEY=text
OCR_LANG=chi_sim+eng
# OCR 前灰度并放大的倍数；手机截图小字建议 2~3，1 表示只灰度不放大
OCR_UPSCALE=2

# ============ 消息聚合 ============
# 截图消息与订单文本消息的最大间隔（秒），超过则认为是独立消息
IMAGE_FOLLOW_WINDOW_SECONDS=120
# 从订单截图里裁商品缩略图（定位不到就自动跳过，1=开启）
PRODUCT_IMAGE_CROP=1
# 模板消息没配到订单截图时回群提醒发送人补发（配对窗口过后才提醒，同一条只提醒一次）
NOTIFY_MISSING_IMAGE=1

# ============ 消息过滤与回执 ============
# 归档「订单模板消息」与「闲鱼订单截图」；其余消息按「动作意图」识别（退单 / 撤单），
# 确实无关的闲聊才标记「已过滤」，不解析、不回执
# 判定订单截图的关键词（OCR 文本里命中数达到 SCREENSHOT_MIN_HITS 才归档）；
# 出现「订单编号/订单号/交易单号/平台单号/担保账户」任意一个直接判定为订单截图
SCREENSHOT_KEYWORDS=订单编号,订单号,成交价,实付,商品总价,运费,买家,收货,闲鱼,发货
SCREENSHOT_MIN_HITS=2
# 处理完成后的回执：reply=在群里回复该条消息并@发送人，direct=私信发送人，off=不回执
NOTIFY_MODE=reply
# 回执里是否附带订单详情链接（公网部署建议保持 1）
NOTIFY_WITH_LINK=1
# 消息已过去多少分钟后就不再补发回执（0=不限）：补录历史消息、服务中断恢复时别刷屏
NOTIFY_MAX_AGE_MINUTES=60

# ============ 意图识别（退单 / 撤单 / 撤回消息）============
# 不看固定格式：群里说到「退单 / 退货 / 不要了…」按退单处理，「撤单 / 取消订单…」按撤单处理，
# 群里撤回订单消息则自动置为已撤单。下面两个词表留空就用内置词库，配置了则以配置为准
REFUND_KEYWORDS=此单退,退单,退货,退款,拦截
CANCEL_KEYWORDS=撤单,取消订单,此单取消,作废,不发了
# 退单消息回溯多少天去匹配原订单
REFUND_MATCH_DAYS=90
# 一句话没写清是哪一单时，按「同一发送人最近 N 天的在途订单」兜底关联
INTENT_MATCH_DAYS=7
# 识别到退单 / 撤单后是否回群告知处理结果
REFUND_NOTIFY=1
CANCEL_NOTIFY=1
# 退单回执除 @ 发送人外，还要一起 @ 的固定人员（供应链对接人，多个用逗号分隔）
REFUND_CC_NAMES=牛磊
# 上面这些人的 open_id（与姓名一一对应，形如 ou_xxx）：留空则自动去群成员名单里按姓名找
REFUND_CC_OPEN_IDS=
# 退单回执文案：@ 发送人的一句（确认收到）+ @ 固定人员的一句（处理口径）
REFUND_ACK_TEXT=退单信息已收到！
REFUND_CC_TEXT=已识别到本单退单申请，会尽快联系供应链拦截处理！有问题随时沟通。

# ============ 公网部署 ============
# 对外域名/地址（生成图片外链、飞书回调提示用）
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 后台账号（存库）。首次启动自动建管理员：账号取 ADMIN_USERNAME（留空 admin），
# 密码取 ADMIN_PASSWORD（留空 xianyu2026）；登录后到「用户管理」可建子账号、改密码
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 登录会话签名密钥：留空自动生成到 data/.secret_key（多副本部署请显式配置一致）
SECRET_KEY=
# 登录有效期（小时）
SESSION_TTL_HOURS=12
# 1 = 订单截图免鉴权（供应链可直接打开导出链接里的图片），默认需要登录
AUTH_PUBLIC_MEDIA=0

# docker compose 部署用（仅本机运行时不用管）
DOMAIN=order.example.com
POSTGRES_PASSWORD=
# 使用 PostgreSQL 时的连接串，示例：
# DATABASE_URL=postgresql+psycopg://orderhub:密码@127.0.0.1:5432/orderhub
